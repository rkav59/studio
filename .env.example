# Public Supabase project configuration. Never place a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Canonical deployed app origin, used for invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Server-only AI and optional transactional-email configuration.
# Server-only Gemini API key from Google AI Studio. Set in Vercel Production and Preview secrets.
# Do not prefix with NEXT_PUBLIC_ or commit the value.
GOOGLE_GENAI_API_KEY=
# All SHEiQpro AI workflows share this model; change only after validation.
# Confirm paid billing and data terms before enabling.
AI_PAID_TIER_CONFIRMED=false
# Server-only; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
