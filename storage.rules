rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Existing contractor document paths are user-scoped. Keep them protected
    // while the application is migrated to organization-scoped paths.
    match /contractor_documents/{userId}/{contractorId}/{documentId}/{fileName} {
      allow read, write: if isOwner(userId);
    }

    // Deny all unclassified storage paths by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
